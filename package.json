{
  "name": "slides-workspace",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "slides dev ./content/gravity-at-sea",
    "build": "slides build ./content/gravity-at-sea",
    "preview": "slides preview ./content/gravity-at-sea",
    "check": "slides check ./content/gravity-at-sea",
    "validate": "slides validate ./content/gravity-at-sea",
    "iiif": "slides iiif ./content/gravity-at-sea",
    "bundle": "pnpm --filter @allmaps/slides run build",
    "test:package": "pnpm --filter @allmaps/slides test:package",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "release:check": "node scripts/check-release.mjs",
    "release:publish": "node scripts/publish-slides.mjs"
  },
  "devDependencies": {
    "@allmaps/slides": "workspace:*",
    "@changesets/cli": "3.0.3"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  }
}
