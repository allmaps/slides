{
  "name": "@allmaps/svelte-canvas-panel",
  "version": "0.0.1",
  "description": "Svelte component for IIIF Atlas Viewer",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm run build",
    "test:package": "node tests/package-smoke.mjs"
  },
  "peerDependencies": {
    "svelte": "^5.51.0"
  },
  "dependencies": {
    "@atlas-viewer/atlas": "3.2.4",
    "@iiif/helpers": "4.0.0",
    "@iiif/parser": "4.0.1",
    "@lucide/svelte": "^1.34.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^25.9.1",
    "svelte": "^5.51.0",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
