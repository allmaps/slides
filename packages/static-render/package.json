{
  "name": "@allmaps/static-render",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "allmaps-static-render": "./bin/render.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./bin/render.mjs",
    "./cache": "./src/cache.ts",
    "./sources": "./src/sources.ts",
    "./warped": "./src/warped.ts",
    "./basemap": "./src/basemap.ts",
    "./types": "./src/types.ts",
    "./context": "./src/context.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:native": "SLIDES_TEST_NATIVE=true node --test tests/native.test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@allmaps/annotation": "1.0.0-beta.37",
    "@allmaps/project": "1.0.0-beta.9",
    "@allmaps/render": "1.0.0-beta.83",
    "@allmaps/slides-model": "workspace:*",
    "@allmaps/sveltekit-iiif": "workspace:*",
    "chiitiler": "1.24.2",
    "maplibre-gl": "^5.19.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  }
}
